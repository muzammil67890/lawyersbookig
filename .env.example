APP_NAME="Legal Connect"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=legal_connect
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
# Session security (Phase 3). SESSION_HTTP_ONLY and SESSION_SAME_SITE
# already default securely (true / "lax") in config/session.php even
# when unset here. Set SESSION_SECURE_COOKIE=true once the app is
# served over HTTPS (leave unset/false for local http:// development,
# or the session cookie will not be sent and login will appear to fail).
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Mail (Phase 3 email verification / password reset). Defaults to the
# "log" driver, so verification/reset emails are written to
# storage/logs/laravel.log instead of being delivered anywhere -- fine
# for local development, but nobody actually receives an email until
# this is pointed at a real mailer (SMTP, Mailpit, etc.).
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@legalconnect.test"
MAIL_FROM_NAME="${APP_NAME}"
